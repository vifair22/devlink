# clang-tidy configuration for devlink.
#
# The enabled set is the checks that find real defects in C: the static
# analyser, the bugprone family, CERT's security rules, and the performance
# and portability groups. Everything switched off below is off for a stated
# reason rather than because it was noisy once.
#
# `make tidy` runs this over the native sources and, separately, over the
# Win32 agent sources against mingw-w64's headers; see the Makefile and
# .clangd, which give an editor the same view.

Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,

  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-braces-around-statements,
  -readability-isolate-declaration,
  -readability-avoid-nested-conditional-operator,
  -bugprone-easily-swappable-parameters,
  -misc-no-recursion,
  -cert-err33-c,
  -bugprone-suspicious-realloc-usage,
  -misc-include-cleaner,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -bugprone-multi-level-implicit-pointer-conversion,
  -readability-implicit-bool-conversion,
  -readability-trailing-comma,
  -performance-no-int-to-ptr,

WarningsAsErrors: '*'
HeaderFilterRegex: '(include|src)/.*\.h$'
FormatStyle: none

CheckOptions:
  # Codepoints and byte values are clearer in hex.
  - key: readability-uppercase-literal-suffix.NewSuffixes
    value: 'L;U;LL;ULL'
  - key: readability-else-after-return.WarnOnConditionVariables
    value: 'false'
  # Keeps the check for genuinely signed operands, which is the defect it
  # exists to catch, while allowing the positive literals that make up every
  # instance here. See the note below.
  - key: bugprone-signed-bitwise.IgnorePositiveIntegerLiterals
    value: 'true'

# Why each exclusion:
#
# readability-magic-numbers
#   The protocol is defined in terms of specific numbers: a 5-byte record
#   header, a 32-frame window, 4 KiB chunks. The named constants live in
#   proto.h and link.h; naming every arithmetic occurrence as well would
#   obscure the format rather than explain it.
#
# readability-identifier-length
#   Short names are idiomatic in C for tight scopes: `p` and `n` in a scan
#   loop read better than `current_pointer` and `sequence_length`.
#
# readability-function-cognitive-complexity
#   The link state machine, the agent's record handlers and the CLI's option
#   parser are branchy by nature. Splitting them to satisfy a metric would
#   spread one coherent decision across several functions.
#
# readability-braces-around-statements, readability-isolate-declaration
#   Style, not correctness, and the codebase is already consistent.
#
# bugprone-easily-swappable-parameters
#   Fires on every (buffer, length) pair, which is most of this API.
#
# misc-no-recursion
#   walk_dir in the fs backends recurses by design; its depth is bounded by
#   WL_PATH_MAX and its stack cost is checked by `make analyze`.
#
# cert-err33-c
#   Demands checking the return of every printf. The agent's log lines and the
#   client's output have nothing useful to do about a failed write to a stream
#   that has already failed.
#
# bugprone-suspicious-realloc-usage
#   Fires on the grow-by-doubling idiom, used by the @dir listing buffer.
#   It assigns through a temporary and frees on failure, which is the pattern
#   the check exists to encourage.
#
# misc-include-cleaner
#   Wants every symbol's defining header included directly, even when a
#   project header already provides it by design. link.h exists precisely so a
#   caller gets the frame and status types with it; satisfying the check would
#   mean pasting the dependency graph into every file and defeating the
#   layering.
#
# clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#   Demands the C11 Annex K functions (snprintf_s, memset_s). Annex K is
#   optional, neither glibc nor Open Watcom implements it, and every bounded
#   call here already passes an explicit size and checks the result.
#
# bugprone-multi-level-implicit-pointer-conversion
#   Fires on passing a char ** to free() and on assigning realloc's void *
#   back. Implicit conversion to and from void * is how C is written; the
#   check is aimed at C++.
#
# readability-implicit-bool-conversion
#   C has no native bool, and testing an int for truth or returning a status
#   as an int is ordinary C. Satisfying the check would mean sprinkling
#   "!= 0" and "? 1 : 0" through code that is already clear.
#
# readability-trailing-comma
#   Layout only: it demands a trailing comma on the last enumerator and the
#   last initializer. It arrived in a later clang-tidy and was swept in by the
#   readability-* glob, so it can appear as a pile of new errors on a machine
#   with a newer LLVM without anything in the code having changed.
#
# performance-no-int-to-ptr
#   Win32 passes every message parameter as an integer, so a window procedure
#   that reads a structure out of an LPARAM has to cast one to a pointer, and a
#   control id goes into CreateWindow's HMENU the same way. The check is right
#   in general and inapplicable to this API: the casts are the interface, not a
#   place where a pointer was stored in an int by mistake. Only the windowed
#   agent has any.
#
# bugprone-signed-bitwise.IgnorePositiveIntegerLiterals
#   Not an exclusion: the check stays on. The bit work here is on protocol
#   fields (the 32-bit selective-ack bitmap, the channel flags, the drive
#   letters seen as a bitmask) against positive literals. The literal is an
#   int because that is what C makes an unquoted constant; none of them can be
#   negative. The option narrows the check to operands that really are signed,
#   which is the case worth failing a build over.
